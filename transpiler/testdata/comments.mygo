package main

import "fmt"

// process keeps comments through transpilation.
func process() error {
	// call someFunc before printing
	result := someFunc()? // original call
	fmt.Println(result)  // print result
	other := someFunc()?
	// comment after a try expression
	fmt.Println(other)
	return nil
}

func someFunc() (string, error) {
	return "hello", nil
}
