package main

func someFunc() (int, error) {
	return 1, nil
}

func boolFunc() (bool, error) {
	return true, nil
}

func callSomeFunc() (bool, error) {
	if someFunc()? > 0 {
		return true, nil
	} else if boolFunc() ? {
        return true, nil
    }

    if boolFunc()? {
        return true, nil
    }

	return false, nil
}